<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows 10 1809 is the floor: SetProcessDpiAwarenessContext needs 1703+. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>PcCore.Windows</RootNamespace>
    <!-- Required by the LibraryImport-generated marshalling stubs below. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The only project containing P/Invoke or System.Drawing. Everything here implements an
    interface declared in PcCore.Capabilities, so the capability layer stays platform-neutral
    and unit-testable with fakes.
  -->
  <ItemGroup>
    <ProjectReference Include="..\PcCore.Capabilities\PcCore.Capabilities.csproj" />
    <ProjectReference Include="..\PcCore.NativeInput\PcCore.NativeInput.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The wire contract with the LocalSystem helper, compiled into both sides from one file.

      A link rather than a project reference, and deliberately: PC Core must not gain a dependency on
      the privileged executable, and the privileged executable must not gain one on PC Core. What
      they share is a protocol, and a protocol is exactly the kind of thing that should live in a
      single file both compile rather than in two definitions that agree until they do not.
    -->
    <Compile Include="..\PcCore.SecureCapture\SecureCaptureProtocol.cs" Link="Capture\SecureCaptureProtocol.cs" />
    <Compile Include="..\PcCore.SecureCapture\SecureCaptureMessages.cs" Link="Capture\SecureCaptureMessages.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <!-- DPAPI: the built-in per-user secret protection used for the phone credential. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!--
      Abstractions only, for VirtualHidProbeService. The virtual HID backend needs something to own
      when it is probed, and that something is a hosted service: it has to start with the host, tick
      on its own clock and — the part that matters — release held input during shutdown rather than
      whenever the container gets round to disposing a singleton. The service belongs beside the
      input stack it drives, so the interface comes here rather than the service moving to the host.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The test project may reach internal helpers. These are implementation details that
      deserve their own tests (extended-prefix stripping, display parsing) without being
      promoted to public API.
    -->
    <InternalsVisibleTo Include="PcCore.Tests" />
  </ItemGroup>

</Project>

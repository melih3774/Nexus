{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },

  "PcCore": {
    "Transport": {
      "Port": 47811,
      "RequireToken": true,
      "MaxRequestBytes": 65536
    },

    "//Files": "Nothing on disk is reachable unless it is listed here. Tokens: {Desktop} {Documents} {Downloads} {Pictures} {Music} {Videos} {UserProfile}. Absolute paths are also accepted.",
    "Files": {
      "AllowedRoots": [
        "{Desktop}",
        "{Documents}",
        "{Downloads}"
      ]
    },

    "Screen": {
      "Enabled": true,
      "MaxWidthLimit": 7680
    }
  }
}

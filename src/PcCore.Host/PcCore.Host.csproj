<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>PcCore.Host</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>PcCore.Host</AssemblyName>
    <UserSecretsId>pccore-host</UserSecretsId>

    <!--
      For the tray icon, and for nothing else. NotifyIcon is the supported way to put an icon in the
      notification area, and the alternative - Shell_NotifyIcon with a message-only window and
      TrackPopupMenu by hand - is two hundred lines of P/Invoke to reimplement a control that ships
      with the framework. PC Core stays a console process; the tray runs on its own STA thread.
    -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- The Windows Forms designer/entry-point conventions do not apply: this is still a Web SDK
         application whose Main is written out by hand. -->
    <EnableWindowsFormsHighDpiAutoResizing>false</EnableWindowsFormsHighDpiAutoResizing>
  </PropertyGroup>

  <!--
    The composition root: the only project that knows every layer. No layer knows it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\PcCore.Capabilities\PcCore.Capabilities.csproj" />
    <ProjectReference Include="..\PcCore.Protocol\PcCore.Protocol.csproj" />
    <ProjectReference Include="..\PcCore.Transport.Loopback\PcCore.Transport.Loopback.csproj" />
    <ProjectReference Include="..\PcCore.Transport.Remote\PcCore.Transport.Remote.csproj" />
    <ProjectReference Include="..\PcCore.Windows\PcCore.Windows.csproj" />

    <!--
      Referenced so that building PC Core also builds the broker. ReferenceOutputAssembly is false
      because PC Core does not call into it: they are two processes that speak a pipe protocol, and
      linking them would defeat the point of the broker being a small separate binary.
    -->
    <ProjectReference Include="..\PcCore.InputBroker\PcCore.InputBroker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    The broker has to end up next to PcCore.Host.exe. Both ends of the pipe check that: the broker
    only accepts a connection from the PC Core beside it, and PC Core only accepts a pipe served by
    the broker beside it. Those checks are what stops another program the owner happens to be running
    from either driving the elevated input path or intercepting what the owner types — so the two
    files travelling together is a correctness requirement, not packaging convenience.
  -->
  <Target Name="CopyInputBroker" AfterTargets="Build">
    <ItemGroup>
      <BrokerOutput Include="$(MSBuildThisFileDirectory)..\PcCore.InputBroker\bin\$(Configuration)\$(TargetFramework)\PcCore.InputBroker.*" />
    </ItemGroup>
    <Copy SourceFiles="@(BrokerOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- QR rendering for the pairing code. Presentation only, so it stays in the host and never
         reaches the capability layer. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!--
      The Web SDK includes wwwroot for publish but not for the build output directory. The host
      reads the test page from its own base directory, so it has to be copied there too.
    -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

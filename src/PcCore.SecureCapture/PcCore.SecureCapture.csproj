<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The one Nexus component that runs as LocalSystem.

    It has no project references, and that is deliberate rather than incidental: nothing that runs
    with this much privilege should be able to reach input injection, the security workflow, the
    capability dispatcher or the pairing store just because it happens to be linked against them.
    What it can do is take a picture of the desktop that is currently receiving input and hand the
    pixels to the one user who is logged on at the console. The protocol on the wire is the whole
    interface; there is nothing else to call.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>PcCore.SecureCapture</RootNamespace>
    <AssemblyName>PcCore.SecureCapture</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>false</UseWindowsForms>

    <!-- No settings file, no config, no logging framework: it writes to the event log and stops. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      Its own version, not the product's. Replacing this component needs administrator approval, so
      the updater only asks for it when this number differs from the installed service's. Bump it
      whenever anything in this project changes; tools/publish-release.ps1 refuses to publish a
      changed SecureCapture under an unchanged version.
    -->
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>

</Project>

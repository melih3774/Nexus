<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows Graphics Capture (GraphicsCaptureItem, Direct3D11CaptureFramePool) is a WinRT
         API, so this library targets the Windows SDK projections. SupportedOSPlatformVersion
         stays low so CA1416 keeps flagging calls that need a newer Windows than we promise. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
</Project>

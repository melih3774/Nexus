<Window x:Class="PcAssistant.Desktop.RootsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projects Folders" Height="440" Width="640" MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="APPROVED PROJECTS FOLDERS" Style="{StaticResource SectionLabel}" />
      <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource FgMuted}" FontSize="12.5"
                 Text="PC Assistant can use project workspaces inside these folders. Adding one approves its projects; it does not change the workspace selected for a task. Windows and system directories remain blocked." />
    </StackPanel>

    <Border Grid.Row="1" Background="{DynamicResource BgPanel}" CornerRadius="6"
            BorderBrush="{DynamicResource Border}" BorderThickness="1">
      <ListBox ItemsSource="{Binding Roots}" Background="Transparent" BorderThickness="0"
               Margin="6" Foreground="{DynamicResource Fg}" />
    </Border>

    <Grid Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="{Binding WorkspaceFeedback}" FontSize="12" VerticalAlignment="Center"
                 TextWrapping="Wrap" MaxWidth="350" HorizontalAlignment="Left">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ok}" /><Style.Triggers><DataTrigger Binding="{Binding WorkspaceFeedbackIsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Add Projects Folder…" Click="AddRoot_Click" />
        <Button Content="Close" MinWidth="84" Margin="8,0,0,0"
                Style="{StaticResource AccentButton}" Click="Close_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>

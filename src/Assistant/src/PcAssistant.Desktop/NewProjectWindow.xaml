<Window x:Class="PcAssistant.Desktop.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create New Project" Height="460" Width="600" MinHeight="440" MinWidth="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,15">
      <TextBlock Text="CREATE A PROJECT WORKSPACE" Style="{StaticResource SectionLabel}" />
      <TextBlock Text="PC Assistant will create this folder under an approved projects folder and select it for the new task."
                 Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,14">
      <TextBlock Text="Projects folder" Style="{StaticResource SectionLabel}" />
      <ComboBox x:Name="RootCombo" ItemsSource="{Binding Roots}" SelectionChanged="Input_Changed" />
    </StackPanel>

    <StackPanel Grid.Row="2">
      <TextBlock Text="Project folder name" Style="{StaticResource SectionLabel}" />
      <TextBox x:Name="ProjectName" TextChanged="Input_Changed" AutomationProperties.Name="Project folder name" />
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <TextBlock Text="Full path" Style="{StaticResource SectionLabel}" />
      <TextBox x:Name="FullPath" IsReadOnly="True" TextWrapping="Wrap" IsTabStop="False" />
      <TextBlock x:Name="Feedback" Margin="0,8,0,0" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" MinWidth="88" Click="Cancel_Click" />
      <Button Content="Create Project" MinWidth="112" Margin="8,0,0,0"
              Style="{StaticResource AccentButton}" Click="Create_Click" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>

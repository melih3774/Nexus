<Window x:Class="PcAssistant.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PcAssistant.Desktop.ViewModels"
        Title="PC Assistant" Height="760" Width="1180"
        MinHeight="520" MinWidth="900"
        Background="{DynamicResource Bg}"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>

    <!-- Owner / Claude / system message -->
    <DataTemplate DataType="{x:Type vm:MessageItem}">
      <Border Margin="0,6" Padding="14,10" CornerRadius="8" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" FontSize="12"
                     Foreground="{DynamicResource FgMuted}" Margin="0,0,0,5" />
          <TextBox Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True"
                   Background="Transparent" BorderThickness="0" Padding="0" FontSize="14" IsTabStop="False"
                   AutomationProperties.Name="Message text" />
        </StackPanel>
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsOwner}" Value="True">
                <Setter Property="Background" Value="{DynamicResource OwnerBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource OwnerBorder}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsSystem}" Value="True">
                <Setter Property="Background" Value="{DynamicResource SystemBg}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SystemBorder}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>
    </DataTemplate>

    <!-- One structured progress line -->
    <DataTemplate DataType="{x:Type vm:ProgressItem}">
      <StackPanel Margin="2,2">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="12"
                     VerticalAlignment="Top" Margin="0,1,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsFailure}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <TextBlock Grid.Column="1" Text="{Binding ActivityTitle}" TextWrapping="Wrap"
                     Foreground="{DynamicResource FgMuted}" FontSize="12.5" />

          <Button Grid.Column="2" Content="Details" Padding="7,1" FontSize="11"
                  Margin="8,0,0,0" VerticalAlignment="Top"
                  Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"
                  Click="ToggleDetail_Click" />
        </Grid>

        <Border Margin="18,5,0,6" Padding="10,8" CornerRadius="6"
                Background="{DynamicResource BgInput}"
                Visibility="{Binding DetailVisible, Converter={StaticResource BoolToVis}}">
          <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"
                     FontSize="11.5" Foreground="{DynamicResource FgMuted}" />
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- Approval card: distinct from an ordinary question -->
    <DataTemplate DataType="{x:Type vm:ApprovalItem}">
      <Border Margin="0,8" Padding="14,12" CornerRadius="8"
              Background="{DynamicResource ApprovalBg}" BorderBrush="{DynamicResource Warn}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="{Binding CategoryText}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource Warn}" Margin="0,0,0,7" />

          <TextBlock Text="{Binding Action}" FontWeight="SemiBold" TextWrapping="Wrap" />

          <Border Margin="0,8" Padding="10,7" CornerRadius="5" Background="{DynamicResource BgInput}">
            <TextBlock Text="{Binding Target}" TextWrapping="Wrap"
                       FontFamily="Cascadia Mono, Consolas" FontSize="12" />
          </Border>

          <!-- Consequence-aware detail. Each row only appears when the request carries it,
               so an ordinary approval stays as short as it was. -->
          <Grid Margin="0,2,0,8" Visibility="{Binding HasConsequence, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Privilege" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgMuted}" Margin="0,0,10,3"
                       Visibility="{Binding HasPrivilege, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Privilege}" FontSize="11.5" TextWrapping="Wrap"
                       Margin="0,0,0,3"
                       Visibility="{Binding HasPrivilege, Converter={StaticResource BoolToVis}}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Effect" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgMuted}" Margin="0,0,10,3" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Consequence}" FontSize="11.5"
                       TextWrapping="Wrap" Margin="0,0,0,3" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Claude says" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgMuted}" Margin="0,0,10,3"
                       Visibility="{Binding HasJustification, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Justification}" FontSize="11.5"
                       TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,3"
                       Foreground="{DynamicResource FgMuted}"
                       Visibility="{Binding HasJustification, Converter={StaticResource BoolToVis}}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Task" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgMuted}" Margin="0,0,10,0"
                       Visibility="{Binding HasTaskTitle, Converter={StaticResource BoolToVis}}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TaskTitle}" FontSize="11.5"
                       TextWrapping="Wrap" Foreground="{DynamicResource FgMuted}"
                       Visibility="{Binding HasTaskTitle, Converter={StaticResource BoolToVis}}" />
          </Grid>

          <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{DynamicResource FgMuted}" Margin="0,0,0,10" />

          <StackPanel Orientation="Horizontal"
                      Visibility="{Binding IsResolved, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <Button Content="Deny" Command="{Binding DenyCommand}" MinWidth="88" />
            <Button Content="Allow once" Command="{Binding AllowCommand}" MinWidth="88"
                    Margin="8,0,0,0" Style="{StaticResource AccentButton}" />
            <Button Content="Allow for this task" Command="{Binding AllowForTaskCommand}"
                    Margin="8,0,0,0" ToolTip="{Binding ScopeDescription}"
                    Visibility="{Binding CanAllowForTask, Converter={StaticResource BoolToVis}}" />
          </StackPanel>

          <TextBlock Text="{Binding ScopeDescription}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource FgMuted}" Margin="0,8,0,0"
                     Visibility="{Binding CanAllowForTask, Converter={StaticResource BoolToVis}}" />

          <TextBlock Text="{Binding OutcomeText}" FontWeight="SemiBold" FontSize="12"
                     Foreground="{DynamicResource FgMuted}"
                     Visibility="{Binding IsResolved, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ===== Title bar ===== -->
    <Border Grid.Row="0" Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource Border}"
            BorderThickness="0,0,0,1" Padding="16,10">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="PC Assistant" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="Your computer, one conversation" FontSize="11" Foreground="{DynamicResource FgMuted}"
                     Margin="8,4,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="ThemeButton" Content="Theme: System" Click="Theme_Click" Margin="0,0,8,0"
                  ToolTip="Switch between system, dark and light appearance" />
          <Button Content="Capabilities" Command="{Binding ShowCapabilitiesCommand}" Margin="0,0,16,0"
                  ToolTip="Check Claude, browser, screen and PC tool availability" />
          <TextBlock Text="{Binding ClaudeStatusGlyph}" VerticalAlignment="Center" FontSize="14"
                     Margin="0,0,6,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ClaudeStatusText}" Value="Ready">
                    <Setter Property="Foreground" Value="{DynamicResource Ok}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <TextBlock Text="{Binding ClaudeStatusText}" VerticalAlignment="Center"
                     ToolTip="{Binding ClaudeStatusDetail}" Margin="0,0,18,0" />

          <Border CornerRadius="6" Background="{DynamicResource BgInput}" Padding="3"
                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
              <RadioButton Content="AUTO" GroupName="Mode" Margin="0" Padding="10,3"
                           IsChecked="{Binding IsAuto, Mode=OneWay}" Command="{Binding SetAutoCommand}"
                           ToolTip="Routine work proceeds; high-impact operations still ask." />
              <RadioButton Content="ASK" GroupName="Mode" Margin="4,0,0,0" Padding="10,3"
                           IsChecked="{Binding IsAsk, Mode=OneWay}" Command="{Binding SetAskCommand}"
                           ToolTip="Observation is free; actions and changes ask first." />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Body ===== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" MinWidth="200" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Task list -->
      <Border Grid.Column="0" Background="{DynamicResource BgPanel}"
              BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Margin="12,12,12,6">
            <Button Content="+  New Task" Padding="10,8"
                    HorizontalContentAlignment="Left" Command="{Binding NewTaskCommand}"
                    Style="{StaticResource AccentButton}" />
            <Grid Margin="0,8,0,0">
              <TextBox Text="{Binding TaskFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                       Padding="8,5,26,5" AutomationProperties.Name="Search tasks"
                       ToolTip="Filter tasks by title or workspace" />
              <TextBlock Text="Search tasks" Foreground="{DynamicResource FgMuted}" FontSize="12"
                         Margin="10,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"
                         Visibility="{Binding IsTaskFilterActive, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
              <Button Content="✕" Command="{Binding ClearTaskFilterCommand}" Width="20" Height="20"
                      Padding="0" HorizontalAlignment="Right" Margin="0,0,4,0" BorderThickness="0"
                      Background="Transparent" AutomationProperties.Name="Clear task search"
                      Visibility="{Binding IsTaskFilterActive, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <TextBlock Text="{Binding TaskFilterSummary}" FontSize="11" Margin="2,6,0,0"
                       Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap"
                       Visibility="{Binding IsTaskFilterActive, Converter={StaticResource BoolToVis}}" />
          </StackPanel>

          <ListBox Grid.Row="1" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}"
                   Background="Transparent" BorderThickness="0" Margin="6,0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="B" CornerRadius="6" Padding="10,8" Background="Transparent">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="B" Property="Background" Value="{DynamicResource SelectionHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentSoft}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StateGlyph}" Margin="0,0,7,0"
                               Foreground="{DynamicResource FgMuted}" FontSize="12" />
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                               MaxWidth="185" FontSize="13" />
                  </StackPanel>
                  <TextBlock Text="{Binding SubtitleText}" FontSize="11"
                             Foreground="{DynamicResource FgMuted}" Margin="19,2,0,0"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="1" Text="No tasks yet. Start with New Task."
                     Foreground="{DynamicResource FgMuted}" TextAlignment="Center"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

          <Button Grid.Row="2" Content="Manage Projects Folders…" Margin="12" Padding="10,6"
                  Command="{Binding ManageRootsCommand}" />
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                    Background="Transparent" />

      <!-- Task detail -->
      <Grid Grid.Column="2" Margin="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,14,20,12" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1">
          <StackPanel>
            <TextBlock Text="{Binding SelectedTitle}" FontSize="16" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding SelectedSubtitle}" FontSize="11.5"
                       Foreground="{DynamicResource FgMuted}" Margin="0,4,0,0"
                       TextTrimming="CharacterEllipsis" />

            <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowCapabilities, Converter={StaticResource BoolToVis}}">
              <DockPanel Margin="0,0,0,8">
                <Button Content="Refresh" Command="{Binding RefreshCapabilitiesCommand}" DockPanel.Dock="Right" />
                <TextBlock Text="Capabilities and connections" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <ProgressBar Height="3" IsIndeterminate="True" Margin="0,0,0,8"
                           Visibility="{Binding IsRefreshingCapabilities, Converter={StaticResource BoolToVis}}" />
              <TextBox Text="{Binding CapabilityDiagnosticsText, Mode=OneWay}" IsReadOnly="True"
                       TextWrapping="Wrap" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                       AutomationProperties.Name="Capability diagnostics" />


              <!-- Start with Windows. Off unless the owner turns it on; an ordinary per-user
                   Run entry, removable here or from Windows' own Startup apps page. -->
              <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                      Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource Border}"
                      BorderThickness="1">
                <StackPanel>
                  <CheckBox Content="{Binding StartupSummary}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                            IsEnabled="{Binding CanChangeStartup}" FontWeight="SemiBold" FontSize="12.5"
                            AutomationProperties.Name="Start PC Assistant with Windows" />
                  <TextBlock Text="{Binding StartupDetail}" FontSize="11.5" TextWrapping="Wrap"
                             Foreground="{DynamicResource FgMuted}" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <!-- The Nexus bridge. Off by default, and while off there is no pipe at all. A Nexus
                   that asks to connect is shown here and served only once the owner trusts it. -->
              <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                      Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource Border}"
                      BorderThickness="1">
                <StackPanel>
                  <CheckBox Content="Let Nexus on this PC use PC Assistant for its owner-authenticated phone"
                            IsChecked="{Binding NexusBridgeEnabled, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12.5"
                            AutomationProperties.Name="Nexus bridge" />
                  <TextBlock Text="{Binding NexusBridgeStatusText}" FontSize="12" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding NexusBridgeDetailText}" FontSize="11.5" TextWrapping="Wrap"
                             Foreground="{DynamicResource FgMuted}" Margin="0,4,0,0" />
                  <Border Margin="0,8,0,0" Padding="10,7" CornerRadius="6" Background="{DynamicResource ApprovalBg}"
                          BorderBrush="{DynamicResource Warn}" BorderThickness="1"
                          Visibility="{Binding HasNexusCandidate, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                      <TextBlock Text="{Binding NexusCandidateText}" TextWrapping="Wrap" FontSize="12" />
                      <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource FgMuted}" Margin="0,4,0,0"
                                 Text="Trust it only if this is the Nexus you installed. It will be able to start and answer tasks for your authenticated phone." />
                      <Button Content="Trust this Nexus" Command="{Binding TrustNexusCommand}"
                              HorizontalAlignment="Left" Margin="0,8,0,0"
                              AutomationProperties.Name="Trust this Nexus" />
                    </StackPanel>
                  </Border>
                  <Button Content="Forget trusted Nexus" Command="{Binding ForgetNexusCommand}"
                          IsEnabled="{Binding CanForgetNexus}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
              <!-- Administrator operations. Nothing here happens on its own: the helper is
                   installed only when the owner presses the button, and Windows asks for
                   administrator approval on the local PC when they do. -->
              <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                      Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource Border}"
                      BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="{Binding PrivilegedStatusText}" FontWeight="SemiBold" FontSize="12.5"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding PrivilegedDetailText}" FontSize="11.5" TextWrapping="Wrap"
                             Foreground="{DynamicResource FgMuted}" Margin="0,4,0,0" />

                  <ProgressBar Height="3" IsIndeterminate="True" Margin="0,8,0,0"
                               Visibility="{Binding IsPrivilegedBusy, Converter={StaticResource BoolToVis}}" />

                  <WrapPanel Margin="0,10,0,0">
                    <Button Content="Install Privileged Helper…"
                            Command="{Binding InstallPrivilegedHelperCommand}"
                            IsEnabled="{Binding CanInstallHelper}"
                            ToolTip="Installs a Windows service that performs individually approved administrator operations. Windows asks for administrator approval once, on this PC." />
                    <Button Content="Uninstall Privileged Helper" Margin="8,0,0,0"
                            Command="{Binding UninstallPrivilegedHelperCommand}"
                            IsEnabled="{Binding CanUninstallHelper}"
                            ToolTip="Stops and removes the service and everything PC Assistant installed with it." />
                  </WrapPanel>

                  <TextBlock Text="Recent administrator operations" FontSize="11" FontWeight="SemiBold"
                             Foreground="{DynamicResource FgMuted}" Margin="0,12,0,4"
                             Visibility="{Binding HasPrivilegedHistory, Converter={StaticResource BoolToVis}}" />
                  <TextBox Text="{Binding PrivilegedHistoryText, Mode=OneWay}" IsReadOnly="True"
                           Background="Transparent" BorderThickness="0" FontSize="11"
                           FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource FgMuted}"
                           MaxHeight="150" VerticalScrollBarVisibility="Auto"
                           HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                           AutomationProperties.Name="Recent administrator operations"
                           Visibility="{Binding HasPrivilegedHistory, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <ProgressBar Height="2" IsIndeterminate="True" Margin="0,10,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                         AutomationProperties.Name="Assistant is working" />

            <Border Margin="0,10,0,0" Padding="10,7" CornerRadius="6" Background="{DynamicResource ApprovalBg}"
                    BorderBrush="{DynamicResource Warn}" BorderThickness="1"
                    Visibility="{Binding IsInterrupted, Converter={StaticResource BoolToVis}}">
              <TextBlock TextWrapping="Wrap" FontSize="12"
                         Text="PC Assistant exited while this task was running, so its Claude process is gone. Send a follow-up to resume the same session — nothing restarts on its own." />
            </Border>
          </StackPanel>
        </Border>

        <!-- Transcript -->
        <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1" Padding="20,12"
                      ScrollChanged="Transcript_ScrollChanged"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowRawLog, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
          <ItemsControl ItemsSource="{Binding Transcript}" />
        </ScrollViewer>

        <TextBlock Grid.Row="1" Text="Create a task to start a conversation with your computer."
                   Foreground="{DynamicResource FgMuted}" FontSize="14" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"
                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

        <!-- Raw log (optional diagnostic view, not the main UI) -->
        <Border Grid.Row="1" Margin="20,12" CornerRadius="8" Background="{DynamicResource BgInput}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                Visibility="{Binding ShowRawLog, Converter={StaticResource BoolToVis}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12">
            <TextBox Text="{Binding RawLogText, Mode=OneWay}" IsReadOnly="True"
                     Background="Transparent" BorderThickness="0"
                     FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                     Foreground="{DynamicResource FgMuted}" TextWrapping="NoWrap" />
          </ScrollViewer>
        </Border>

        <!-- Composer -->
        <Border Grid.Row="2" Padding="20,12,20,16" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBox x:Name="ComposerBox" Text="{Binding Composer, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62" MaxHeight="160"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Message to PC Assistant"
                     PreviewKeyDown="Composer_PreviewKeyDown" />

            <StackPanel Margin="0,10,0,0">
              <WrapPanel HorizontalAlignment="Right">
                <Button Content="Raw Log" Command="{Binding ToggleRawLogCommand}" />
                <Button Content="Continue as New Task" Margin="8,0,0,0"
                        Command="{Binding ContinueAsNewTaskCommand}"
                        ToolTip="Start a fresh task carrying a short summary of this one." />
                <Button Content="Stop" Margin="8,0,0,0" Command="{Binding StopCommand}"
                        BorderBrush="{DynamicResource Danger}" ToolTip="Stop this task. Ctrl+Alt+Pause stops all tasks." />
                <Button Content="Send" Margin="8,0,0,0" MinWidth="84"
                        Command="{Binding SendCommand}" Style="{StaticResource AccentButton}" />
              </WrapPanel>
              <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Enter to send · Shift+Enter for a new line" FontSize="11"
                           Foreground="{DynamicResource FgMuted}" />
                <TextBlock Text="{Binding StopShortcutText}" FontSize="11" TextAlignment="Right"
                           Foreground="{DynamicResource FgMuted}" />
              </DockPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <RootNamespace>PcAssistant.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The WPF implicit-usings set omits these; the tests touch the filesystem heavily. -->
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Lets the real-Claude suite skip itself unless explicitly enabled. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PcAssistant.Core\PcAssistant.Core.csproj" />
    <ProjectReference Include="..\..\src\PcAssistant.ClaudeCode\PcAssistant.ClaudeCode.csproj" />
    <ProjectReference Include="..\..\src\PcAssistant.Desktop\PcAssistant.Desktop.csproj" />
    <ProjectReference Include="..\..\src\PcAssistant.Windows\PcAssistant.Windows.csproj" />
    <ProjectReference Include="..\..\src\PcAssistant.Elevation.Host\PcAssistant.Elevation.Host.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>PcCore.InputBroker</RootNamespace>
    <AssemblyName>PcCore.InputBroker</AssemblyName>

    <!--
      WinExe rather than Exe: this process is started by Windows at logon and must not put a
      console window on the owner's desktop every time they sign in. Interactive runs attach to the
      parent console instead, so the console switch still prints.
    -->
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <!--
    The only dependency, on purpose. This process runs at a higher integrity level than the rest of
    Nexus, so everything it loads is part of its attack surface: no configuration binder, no logging
    framework, no HTTP stack, no dependency injection. PcCore.NativeInput has no dependencies of its
    own, which keeps the whole elevated surface to two small assemblies plus the BCL.
  -->
  <ItemGroup>
    <ProjectReference Include="..\PcCore.NativeInput\PcCore.NativeInput.csproj" />
  </ItemGroup>

</Project>

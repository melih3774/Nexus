<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred. The Primary Phone credential is sealed by a Keystore key
  that cannot leave this device, so a restored copy would be useless anyway; excluding it outright
  keeps the ciphertext off Google's servers as well.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Requested at the moment the owner taps "Scan QR", never at launch. The app is fully usable
      by pasting a pairing code if the permission is declined.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      The security alert. Android will not wake an app for a network event without either a push
      service or a foreground service, and a push service would mean routing a signal about the
      owner's home through a third party. The foreground service is opt-in, shows a permanent
      notification, and can be stopped from it.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Owner confirmation before a security incident can be stood down. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      Updating Nexus from the APK its own PC serves. This lets the app hand a package to Android's
      installer; it does not let it install anything silently. Android still shows its own
      confirmation, and asks the owner once to allow Nexus as an install source.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".NexusApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nexus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Nexus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".security.SecurityAlertService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Hears back from PackageInstaller about an update: confirm, cancelled, failed. -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
